{
  "version": 1,
  "binds": [
    {
      "id": "launcher",
      "keys": "SUPER + Super_L",
      "desc": "App launcher (tap Super)",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call launcher toggle",
      "opts": {
        "release": true
      }
    },
    {
      "id": "launcher-commands",
      "keys": "SUPER + P",
      "desc": "Command launcher",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call launcher command"
    },
    {
      "id": "wallpaper",
      "keys": "SUPER + B",
      "desc": "Wallpaper picker",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call launcher wallpaper"
    },
    {
      "id": "clipboard",
      "keys": "SUPER + SHIFT + V",
      "desc": "Clipboard history",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call launcher clipboard"
    },
    {
      "id": "settings",
      "keys": "SUPER + S",
      "desc": "Lucid Settings",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call settings toggle"
    },
    {
      "id": "moji",
      "keys": "SUPER + period",
      "desc": "Emoji picker",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call moji toggle"
    },
    {
      "id": "keyboard",
      "keys": "SUPER + K",
      "desc": "On-screen keyboard",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call keyboard toggle"
    },
    {
      "id": "keybinds-sheet",
      "keys": "SUPER + slash",
      "desc": "Show keybinds",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call keybinds toggle"
    },
    {
      "id": "overview",
      "keys": "SUPER + W",
      "desc": "Workspace overview",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call workspaces toggle"
    },
    {
      "id": "session",
      "keys": "SUPER + Escape",
      "desc": "Session screen: lock, sleep, log out, restart, shut down",
      "category": "Lucid",
      "type": "exec",
      "cmd": "qs ipc call session toggle"
    },
    {
      "id": "switcher",
      "keys": "CTRL + ALT + Tab",
      "desc": "Window switcher, every workspace",
      "category": "Windows",
      "type": "exec",
      "cmd": "qs ipc call switcher next"
    },
    {
      "id": "switcher-back",
      "keys": "CTRL + ALT + SHIFT + Tab",
      "desc": "Window switcher, stepping back",
      "category": "Windows",
      "type": "exec",
      "cmd": "qs ipc call switcher prev"
    },
    {
      "id": "close",
      "keys": "SUPER + C",
      "desc": "Close window",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.window.close()"
    },
    {
      "id": "exit",
      "keys": "SUPER + M",
      "desc": "Exit Hyprland",
      "category": "Windows",
      "type": "exec",
      "cmd": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"
    },
    {
      "id": "files",
      "keys": "SUPER + E",
      "desc": "File manager",
      "category": "Apps",
      "type": "exec",
      "cmd": "nautilus"
    },
    {
      "id": "float",
      "keys": "SUPER + V",
      "desc": "Toggle floating",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.window.float({ action = \"toggle\" })"
    },
    {
      "id": "split",
      "keys": "SUPER + SHIFT + Return",
      "desc": "Toggle split direction",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.layout(\"togglesplit\")"
    },
    {
      "id": "focus-left",
      "keys": "SUPER + left",
      "desc": "Focus left",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"left\" })"
    },
    {
      "id": "focus-right",
      "keys": "SUPER + right",
      "desc": "Focus right",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"right\" })"
    },
    {
      "id": "focus-up",
      "keys": "SUPER + up",
      "desc": "Focus up",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"up\" })"
    },
    {
      "id": "focus-down",
      "keys": "SUPER + down",
      "desc": "Focus down",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"down\" })"
    },
    {
      "id": "ws-focus",
      "keys": "SUPER + {key}",
      "desc": "Workspace {n}",
      "category": "Workspaces",
      "type": "lua",
      "lua": "hl.dsp.focus({ workspace = {n} })",
      "each": "workspace"
    },
    {
      "id": "ws-move",
      "keys": "SUPER + SHIFT + {key}",
      "desc": "Move window to workspace {n}",
      "category": "Workspaces",
      "type": "lua",
      "lua": "hl.dsp.window.move({ workspace = {n} })",
      "each": "workspace"
    },
    {
      "id": "scratchpad",
      "keys": "SUPER + SHIFT + S",
      "desc": "Scratchpad, or put away the open special workspace",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.scratchpad()"
    },
    {
      "id": "scratchpad-stash",
      "keys": "SUPER + ALT + S",
      "desc": "Stash the focused window, or bring it back",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.stash()"
    },
    {
      "id": "special-music",
      "keys": "SUPER + SHIFT + M",
      "desc": "Music workspace",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.toggle(\"music\")"
    },
    {
      "id": "special-comms",
      "keys": "SUPER + SHIFT + D",
      "desc": "Comms workspace",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.toggle(\"comms\")"
    },
    {
      "id": "special-todo",
      "keys": "SUPER + SHIFT + R",
      "desc": "To-do workspace",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.toggle(\"todo\")"
    },
    {
      "id": "special-sysmon",
      "keys": "CTRL + SHIFT + Escape",
      "desc": "System monitor workspace",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.toggle(\"sysmon\")"
    },
    {
      "id": "ws-scroll-next",
      "keys": "SUPER + mouse_down",
      "desc": "Next workspace (scroll)",
      "category": "Workspaces",
      "type": "lua",
      "lua": "hl.dsp.focus({ workspace = \"e+1\" })"
    },
    {
      "id": "ws-scroll-prev",
      "keys": "SUPER + mouse_up",
      "desc": "Previous workspace (scroll)",
      "category": "Workspaces",
      "type": "lua",
      "lua": "hl.dsp.focus({ workspace = \"e-1\" })"
    },
    {
      "id": "drag",
      "keys": "SUPER + mouse:272",
      "desc": "Move window (drag)",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.window.drag()",
      "opts": {
        "mouse": true
      }
    },
    {
      "id": "resize",
      "keys": "SUPER + mouse:273",
      "desc": "Resize window (drag)",
      "category": "Windows",
      "type": "lua",
      "lua": "hl.dsp.window.resize()",
      "opts": {
        "mouse": true
      }
    },
    {
      "id": "f1-mute",
      "keys": "F1",
      "desc": "Mute",
      "category": "Function keys",
      "type": "exec",
      "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "f2-vol-down",
      "keys": "F2",
      "desc": "Volume down",
      "category": "Function keys",
      "type": "exec",
      "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "f3-vol-up",
      "keys": "F3",
      "desc": "Volume up",
      "category": "Function keys",
      "type": "exec",
      "cmd": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "f4-mic-mute",
      "keys": "F4",
      "desc": "Mute microphone",
      "category": "Function keys",
      "type": "exec",
      "cmd": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "f5-bright-down",
      "keys": "F5",
      "desc": "Brightness down",
      "category": "Function keys",
      "type": "exec",
      "cmd": "brightnessctl -e4 -n2 set 5%-",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "f6-bright-up",
      "keys": "F6",
      "desc": "Brightness up",
      "category": "Function keys",
      "type": "exec",
      "cmd": "brightnessctl -e4 -n2 set 5%+",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "f8-rfkill",
      "keys": "F8",
      "desc": "Toggle all radios",
      "category": "Function keys",
      "type": "exec",
      "cmd": "rfkill toggle all",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "f9-terminal",
      "keys": "F9",
      "desc": "Terminal",
      "category": "Function keys",
      "type": "exec",
      "cmd": "kitty",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "f10-lock",
      "keys": "F10",
      "desc": "Lock screen",
      "category": "Function keys",
      "type": "exec",
      "cmd": "qs ipc call lock lock",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "f12-calc",
      "keys": "F12",
      "desc": "Calculator",
      "category": "Function keys",
      "type": "exec",
      "cmd": "gnome-calculator",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "xf86-mute",
      "keys": "XF86AudioMute",
      "desc": "Mute",
      "category": "Media keys",
      "type": "exec",
      "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "xf86-vol-down",
      "keys": "XF86AudioLowerVolume",
      "desc": "Volume down",
      "category": "Media keys",
      "type": "exec",
      "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "xf86-vol-up",
      "keys": "XF86AudioRaiseVolume",
      "desc": "Volume up",
      "category": "Media keys",
      "type": "exec",
      "cmd": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "xf86-mic-mute",
      "keys": "XF86AudioMicMute",
      "desc": "Mute microphone",
      "category": "Media keys",
      "type": "exec",
      "cmd": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "xf86-bright-down",
      "keys": "XF86MonBrightnessDown",
      "desc": "Brightness down",
      "category": "Media keys",
      "type": "exec",
      "cmd": "brightnessctl -e4 -n2 set 5%-",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "xf86-bright-up",
      "keys": "XF86MonBrightnessUp",
      "desc": "Brightness up",
      "category": "Media keys",
      "type": "exec",
      "cmd": "brightnessctl -e4 -n2 set 5%+",
      "opts": {
        "locked": true,
        "repeating": true
      }
    },
    {
      "id": "xf86-next",
      "keys": "XF86AudioNext",
      "desc": "Next track",
      "category": "Media keys",
      "type": "exec",
      "cmd": "playerctl next",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "xf86-pause",
      "keys": "XF86AudioPause",
      "desc": "Play / pause",
      "category": "Media keys",
      "type": "exec",
      "cmd": "playerctl play-pause",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "xf86-play",
      "keys": "XF86AudioPlay",
      "desc": "Play / pause",
      "category": "Media keys",
      "type": "exec",
      "cmd": "playerctl play-pause",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "xf86-prev",
      "keys": "XF86AudioPrev",
      "desc": "Previous track",
      "category": "Media keys",
      "type": "exec",
      "cmd": "playerctl previous",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "snap-region",
      "keys": "Print",
      "desc": "Region screenshot",
      "category": "Screenshots",
      "type": "exec",
      "cmd": "qs ipc call snap toggle",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "snap-full",
      "keys": "SUPER + Print",
      "desc": "Full screenshot",
      "category": "Screenshots",
      "type": "exec",
      "cmd": "qs ipc call screenshot full",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "snap-text",
      "keys": "SUPER + SHIFT + T",
      "desc": "Copy text from a region (OCR)",
      "category": "Screenshots",
      "type": "exec",
      "cmd": "qs ipc call snap text",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "snap-color",
      "keys": "SUPER + SHIFT + C",
      "desc": "Pick a colour from the screen",
      "category": "Screenshots",
      "type": "exec",
      "cmd": "qs ipc call snap color",
      "opts": {
        "locked": true
      }
    },
    {
      "id": "reload",
      "keys": "SUPER + R",
      "desc": "Reload Hyprland and the shell",
      "category": "Lucid",
      "type": "exec",
      "cmd": "$HOME/.config/hypr/scripts/reload.sh"
    },
    {
      "id": "qtile-01",
      "keys": "SUPER + D",
      "desc": "App launcher",
      "category": "qtile",
      "type": "exec",
      "cmd": "qs ipc call launcher toggle"
    },
    {
      "id": "qtile-02",
      "keys": "SUPER + W",
      "desc": "Close window",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.window.close()"
    },
    {
      "id": "qtile-03",
      "keys": "SUPER + SHIFT + Q",
      "desc": "Close window",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.window.close()"
    },
    {
      "id": "qtile-04",
      "keys": "SUPER + H",
      "desc": "Focus left",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"left\" })"
    },
    {
      "id": "qtile-05",
      "keys": "SUPER + L",
      "desc": "Focus right",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"right\" })"
    },
    {
      "id": "qtile-06",
      "keys": "SUPER + J",
      "desc": "Focus down",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"down\" })"
    },
    {
      "id": "qtile-07",
      "keys": "SUPER + K",
      "desc": "Focus up",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.focus({ direction = \"up\" })"
    },
    {
      "id": "qtile-08",
      "keys": "SUPER + SHIFT + H",
      "desc": "Move window left",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch movewindow l"
    },
    {
      "id": "qtile-09",
      "keys": "SUPER + SHIFT + L",
      "desc": "Move window right",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch movewindow r"
    },
    {
      "id": "qtile-10",
      "keys": "SUPER + SHIFT + J",
      "desc": "Move window down",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch movewindow d"
    },
    {
      "id": "qtile-11",
      "keys": "SUPER + SHIFT + K",
      "desc": "Move window up",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch movewindow u"
    },
    {
      "id": "qtile-12",
      "keys": "SUPER + CTRL + H",
      "desc": "Shrink window left",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch resizeactive -60 0",
      "opts": {
        "repeating": true
      }
    },
    {
      "id": "qtile-13",
      "keys": "SUPER + CTRL + L",
      "desc": "Grow window right",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch resizeactive 60 0",
      "opts": {
        "repeating": true
      }
    },
    {
      "id": "qtile-14",
      "keys": "SUPER + CTRL + J",
      "desc": "Grow window down",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch resizeactive 0 60",
      "opts": {
        "repeating": true
      }
    },
    {
      "id": "qtile-15",
      "keys": "SUPER + CTRL + K",
      "desc": "Shrink window up",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch resizeactive 0 -60",
      "opts": {
        "repeating": true
      }
    },
    {
      "id": "qtile-16",
      "keys": "SUPER + SHIFT + R",
      "desc": "Reload Hyprland and the shell",
      "category": "qtile",
      "type": "exec",
      "cmd": "$HOME/.config/hypr/scripts/reload.sh"
    },
    {
      "id": "qtile-17",
      "keys": "SUPER + Return",
      "desc": "Terminal",
      "category": "qtile",
      "type": "exec",
      "cmd": "kitty"
    },
    {
      "id": "qtile-18",
      "keys": "SUPER + F",
      "desc": "Toggle fullscreen",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch fullscreen"
    },
    {
      "id": "qtile-19",
      "keys": "SUPER + T",
      "desc": "Toggle floating",
      "category": "qtile",
      "type": "lua",
      "lua": "hl.dsp.window.float({ action = \"toggle\" })"
    },
    {
      "id": "qtile-20",
      "keys": "SUPER + CTRL + Q",
      "desc": "Exit Hyprland",
      "category": "qtile",
      "type": "exec",
      "cmd": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"
    },
    {
      "id": "qtile-21",
      "keys": "Prior",
      "desc": "Suspend",
      "category": "qtile",
      "type": "exec",
      "cmd": "systemctl suspend"
    },
    {
      "id": "qtile-22",
      "keys": "SUPER + space",
      "desc": "Focus next window",
      "category": "qtile",
      "type": "exec",
      "cmd": "hyprctl dispatch cyclenext"
    }
  ]
}